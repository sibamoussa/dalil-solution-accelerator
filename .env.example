# =============================================================================
# Dalil - configuration template
# =============================================================================
# Copy this file to `.env` and fill in every <PLACEHOLDER>. Never commit `.env`.
#   PowerShell:  Copy-Item .env.example .env
#
# Ingestion uses explicit CLI arguments; see the "Ingest the bundled gazettes" section in README.md.
# Values shown after `=` are safe defaults; blank values are required unknowns.
# =============================================================================

# -----------------------------------------------------------------------------
# SHARED - Azure region guardrail (startup fails if resources are elsewhere)
# -----------------------------------------------------------------------------
ALLOWED_AZURE_REGION=uaenorth
SEARCH_RESOURCE_REGION=uaenorth

# -----------------------------------------------------------------------------
# SHARED - Azure AI Search
# -----------------------------------------------------------------------------
# Base endpoint, e.g. https://my-search.search.windows.net
SEARCH_ENDPOINT=https://<SEARCH_RESOURCE>.search.windows.net
FOUNDRY_KNOWLEDGE_BASE=dalil-policies-2026
# Leave credentials blank for Azure CLI locally or managed identity in Azure.
SEARCH_KEY=
SEARCH_BEARER_TOKEN=
AZURE_CLIENT_ID=

# -----------------------------------------------------------------------------
# WEB APP - Azure OpenAI synthesis ("slow") model
# -----------------------------------------------------------------------------
# Full chat completions endpoint incl. deployment + api-version.
AOAI_CHAT_ENDPOINT=https://<AOAI_RESOURCE>.openai.azure.com/openai/deployments/gpt-5-1/chat/completions?api-version=2024-12-01-preview
# Provide EITHER an API key OR a bearer token (key wins if both set).
AOAI_CHAT_API_KEY=
AOAI_CHAT_BEARER_TOKEN=
AOAI_USE_GENERATIVE_SYNTHESIS=true

# -----------------------------------------------------------------------------
# WEB APP - Azure OpenAI fast model (contextualization, verification)
# -----------------------------------------------------------------------------
# Optional. If blank, the app falls back to the synthesis model/credentials.
AOAI_FAST_ENDPOINT=
AOAI_FAST_API_KEY=
AOAI_FAST_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# WEB APP - Citations and presentation
# -----------------------------------------------------------------------------
# Header logo path (served from webapp/assets) or absolute URL.
LOGO_URL=/assets/dalil-mark.svg
ORGANIZATION_SHORT_NAME=Dalil
ORGANIZATION_NAME=Dalil Solution Accelerator
APP_TITLE=Dalil
MATCH_RESPONSE_LANGUAGE_TO_QUESTION=true

# -----------------------------------------------------------------------------
# WEB APP - Quality gates and tuning (safe defaults; override only if needed)
# -----------------------------------------------------------------------------
ANSWERABILITY_THRESHOLD=1.9
GROUNDEDNESS_CHECK_ENABLED=true
GROUNDEDNESS_UNSUPPORTED_THRESHOLD=0.45
GROUNDEDNESS_RETRY_ATTEMPTS=2
MAX_EVIDENCE_ITEMS=12
MAX_CHUNKS_PER_DOCUMENT=4
MIN_EVIDENCE_WORDS=8
QUERY_CONTEXTUALIZATION_ENABLED=true
QUERY_NORMALIZATION_ENABLED=true

# -----------------------------------------------------------------------------
# DEPLOYMENT - Azure Container Apps target (used by deploy.ps1)
# -----------------------------------------------------------------------------
AZURE_RESOURCE_GROUP=<RESOURCE_GROUP>
AZURE_CONTAINER_APP=<CONTAINER_APP_NAME>
AZURE_CONTAINER_REGISTRY=<ACR_NAME_WITHOUT_azurecr.io>
AZURE_IMAGE_NAME=dalil-knowledge-assistant
